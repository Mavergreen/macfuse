{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>Mavergreen/shipyard"],
  "gitIgnoredAuthors": ["342268518+mavergreen-pins-bot[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track upstream macFUSE releases (tags are macfuse-<version>; pre-releases are not tracked).",
      "managerFilePatterns": ["/^UPSTREAM_VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "macfuse/macfuse",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^macfuse-(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "The clang22 pin: a Mavergreen/clang-22 release tag.",
      "managerFilePatterns": ["/^components/clang22/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/clang-22",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mavericks\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "The Recaulk pin: a Mavergreen/recaulk release tag, bare, whose upstream version is a date, YYYYMMDD.N.",
      "managerFilePatterns": ["/^components/recaulk/version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)\\s*$"],
      "depNameTemplate": "Mavergreen/recaulk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d{8})\\.(?<minor>\\d+)$"
    }
  ]
}
